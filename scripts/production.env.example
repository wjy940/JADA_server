# Install as /etc/severe-equipment-assets.env, root:root, mode 600.
# Replace all placeholders. Never commit real passwords.
DB_URL=jdbc:postgresql://127.0.0.1:5432/severe_equipment_assets
DB_USERNAME=equipment_api
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
ATTACHMENT_DIR=/var/lib/severe-equipment-assets/attachments
# Optional first bootstrap only; only applies when admin password_hash is null.
# Existing administrator credentials must be rotated through the password API.
# APP_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
SPRING_PROFILES_ACTIVE=prod
