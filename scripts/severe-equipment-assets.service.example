[Unit]
Description=Severe Equipment Assets API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=equipment-api
Group=equipment-api
WorkingDirectory=/opt/severe-equipment-assets
EnvironmentFile=/etc/severe-equipment-assets.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/severe-equipment-assets/app.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/severe-equipment-assets/attachments

[Install]
WantedBy=multi-user.target
