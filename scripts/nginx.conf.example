server {
    listen 80;
    server_name equipment.example.com;
    root /var/www/equipment-assets;
    index index.html;
    client_max_body_size 6m;

    location / {
        try_files $uri $uri/ /index.html;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8080/api/;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Backend validates persisted Bearer sessions; Authorization passes through.
        # Do not trust user-supplied identity headers on an Internet-facing proxy.
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header X-Data-Scope "";
    }
}
